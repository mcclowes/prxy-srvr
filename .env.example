# Required. The proxy returns 503 without it, so it can never be left open.
# Generate one with: openssl rand -hex 32
PROXY_KEY=

# Identifies this deployment in /health and the x-proxy-id response header.
# Give each of the three deployments a different value.
PROXY_ID=proxy-a

# Optional. Comma separated hosts this deployment may reach. `*.example.com`
# matches subdomains and the apex. Unset means any public host.
ALLOWED_TARGETS=

# Optional. Comma separated origins allowed to call the proxy from a browser.
# Unset means `*`.
ALLOWED_ORIGINS=

# Optional. Milliseconds to wait for the upstream. Defaults to 20000.
UPSTREAM_TIMEOUT_MS=
